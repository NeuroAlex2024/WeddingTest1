# Конфигурация сервера
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# База данных PostgreSQL
# Замени на свои данные подключения
DATABASE_URL=\
postgresql://postgres:password@localhost:5432/wedding_db?schema=public\

# Для разработки можешь использовать локальный PostgreSQL или Docker:
# docker run --name wedding-postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=wedding_db -p 5432:5432 -d postgres:15

# JWT секреты (ОБЯЗАТЕЛЬНО измени в продакшене!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Логирование
LOG_LEVEL=info
HTTP_LOG_FORMAT=dev
PRISMA_LOG_LEVELS=warn,error

# Локализация
APP_LOCALE=ru-RU
